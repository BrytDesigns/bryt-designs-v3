# Copy to .env for local dev, builds and personal Alchemy stages, and to
# .env.production for production deploys (`pnpm run deploy`, which reads only
# that file). Get the production values from the team password manager:
# every deployer must use the same ones. Every variable is declared and
# validated in env.ts.

# Signs the session cookie. Comma-separated, newest first: prepend a new
# secret to rotate ("new,old"), then drop the old one after a week.
# Generate one: openssl rand -base64 32
SESSION_SECRET=
