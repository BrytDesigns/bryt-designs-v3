{
  "name": "bryt-designs-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @repo/web preview",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy": "alchemy deploy --stage production",
    "destroy": "alchemy destroy",
    "lint": "oxlint apps packages"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-node": "catalog:",
    "alchemy": "2.0.0-beta.84",
    "effect": "catalog:",
    "eslint-plugin-solid": "~0.18.1",
    "oxlint": "~1.79.0",
    "typescript": "catalog:"
  }
}
